      "loop": true
    },
    {
      "id": "walk",
      "label": "Walk (se), stepping along the ground",
      "frames": 8,
      "fps": 12,
      "loop": true
    },
    {
      "id": "work",
      "label": "Work: typing at a desk",
      "frames": 4,
      "fps": 6,
      "loop": true
    },
    {
      "id": "sit",
      "label": "Sit: on a sofa, an armchair or a bench",
