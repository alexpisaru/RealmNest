{
  "id": "alex",
  "name": "Alex (founder)",
  "generator": "tools/charpipe/build.ts (EffectCraft)",
  "effectcraft": "effectcraft-cli 0.8.0",
  "rig": "nestra-humanoid-3q",
  "view": "se",
  "frameWidth": 80,
  "frameHeight": 128,
  "anchor": {
    "x": 40,
    "y": 120
  },
  "layout": "horizontal strip, no padding, frame i at x = i * frameWidth",
  "modes": {
    "x1": "parts rendered at 1×, Draft (nearest-neighbour) layers",
    "rotsprite": "parts enlarged 8× with Scale2x, rendered at 8×, sampled back (RotSprite)"
  },
  "outfits": {
    "default": "Field jacket (shipped)",
    "navy": "Navy jacket + tan chinos (recolour test)"
  },
  "accessories": {
    "beanie": "Knit beanie"
  },
  "animations": [
    {
      "id": "idle",
      "label": "Idle: breathing",
      "frames": 8,
      "fps": 8,
      "loop": true
    },
    {
      "id": "walk",
      "label": "Walk (se), stepping along the ground",
      "frames": 8,
      "fps": 12,
      "loop": true
    },
    {
      "id": "work",
      "label": "Work: typing at a desk",
      "frames": 4,
      "fps": 6,
      "loop": true
    },
    {
      "id": "walk_planar",
      "label": "Walk, limbs turning in the screen plane (rejected)",
      "frames": 8,
      "fps": 12,
      "loop": true
    }
  ],
